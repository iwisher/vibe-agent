{
  "post-edit-lint": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/post_edit_lint.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
